--TOGGLE FACTORY (with lock/unlock support)
local toggles = {} -- keep references so we can unlock them later

local function createToggle(labelText, yPos)
	local holder = Instance.new("Frame")
	holder.Name = "Toggle_" .. labelText
	holder.Size = UDim2.new(1, -30, 0, 40)
	holder.Position = UDim2.new(0.5, 0, 0, yPos)
	holder.AnchorPoint = Vector2.new(0.5, 0)
	holder.BackgroundColor3 = COLOR_PANEL
	holder.Parent = main

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = holder

	local stroke = Instance.new("UIStroke")
	stroke.Color = COLOR_BORDER
	stroke.Thickness = 1
	stroke.Parent = holder

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(0.5, 0, 1, 0)
	label.Position = UDim2.new(0, 15, 0, 0)
	label.Font = Enum.Font.Gotham
	label.Text = labelText
	label.TextColor3 = COLOR_LABEL_LOCKED
	label.TextSize = 14
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = holder

	local switchBg = Instance.new("Frame")
	switchBg.Size = UDim2.new(0, 44, 0, 22)
	switchBg.Position = UDim2.new(1, -55, 0.5, -11)
	switchBg.BackgroundColor3 = COLOR_TOGGLE_LOCKED
	switchBg.Parent = holder

	local switchCorner = Instance.new("UICorner")
	switchCorner.CornerRadius = UDim.new(1, 0)
	switchCorner.Parent = switchBg

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 18, 0, 18)
	knob.Position = UDim2.new(0, 2, 0.5, -9)
	knob.BackgroundColor3 = Color3.fromRGB(150, 150, 150)
	knob.Parent = switchBg

	local knobCorner = Instance.new("UICorner")
	knobCorner.CornerRadius = UDim.new(1, 0)
	knobCorner.Parent = knob

	local clickBtn = Instance.new("TextButton")
	clickBtn.Size = UDim2.new(1, 0, 1, 0)
	clickBtn.BackgroundTransparency = 1
	clickBtn.Text = ""
	clickBtn.Active = false -- locked by default
	clickBtn.Parent = switchBg

	local state = false
	local unlocked = false

	clickBtn.MouseButton1Click:Connect(function()
		if not unlocked then return end -- extra safety check

		state = not state
		local targetPos = state and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
		local targetColor = state and COLOR_TOGGLE_ON or COLOR_TOGGLE_OFF

		TweenService:Create(knob, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {Position = targetPos}):Play()
		TweenService:Create(switchBg, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {BackgroundColor3 = targetColor}):Play()

		--Put your toggle logic here
		print(labelText .. " toggled: " .. tostring(state))
	end)

	local toggleData = {}

	function toggleData.Unlock()
		if unlocked then return end
		unlocked = true
		clickBtn.Active = true
		TweenService:Create(label, TweenInfo.new(0.2), {TextColor3 = COLOR_TEXT}):Play()
		TweenService:Create(switchBg, TweenInfo.new(0.2), {BackgroundColor3 = COLOR_TOGGLE_OFF}):Play()
		TweenService:Create(knob, TweenInfo.new(0.2), {BackgroundColor3 = COLOR_TEXT}):Play()
	end

	function toggleData.Lock()
		unlocked = false
		clickBtn.Active = false
		state = false
		knob.Position = UDim2.new(0, 2, 0.5, -9)
		label.TextColor3 = COLOR_LABEL_LOCKED
		switchBg.BackgroundColor3 = COLOR_TOGGLE_LOCKED
		knob.BackgroundColor3 = Color3.fromRGB(150, 150, 150)
	end

	return toggleData
end

toggles[1] = createToggle("Freez The Trade", 210)
toggles[2] = createToggle("Steal Highest Fruit", 260)

local function unlockToggles()
	toggles[1].Unlock()
	toggles[2].Unlock()
end

local function lockToggles()
	toggles[1].Lock()
	toggles[2].Lock()
end

--DETECTING... ANIMATION
local detectingConnection = nil -- tracks the running animation loop

local function stopDetectingAnimation()
	if detectingConnection then
		detectingConnection = nil
	end
	detectingLabel.Visible = false
end

local function playDetectingAnimation()
	thumbImage.Image = "" -- clear old picture while searching
	detectingLabel.Visible = true

	local myRunId = {} -- unique token so old loops stop themselves
	detectingConnection = myRunId

	task.spawn(function()
		local dots = 0
		while detectingConnection == myRunId do
			dots = (dots % 3) + 1
			detectingLabel.Text = "Detecting" .. string.rep(".", dots)
			task.wait(0.4)
		end
	end)
end

--USERNAME SUBMIT LOGIC
usernameBox.FocusLost:Connect(function(enterPressed)
	if not (enterPressed and usernameBox.Text ~= "") then return end

	local username = usernameBox.Text

	-- lock toggles again while we re-verify (in case user searches a new name)
	lockToggles()
	playDetectingAnimation()

	-- resolve the user id and fetch the thumbnail in the background
	local success, userId = pcall(function()
		return Players:GetUserIdFromNameAsync(username)
	end)

	local thumbContent
	if success and userId then
		local ok, content = pcall(function()
			return Players:GetUserThumbnailAsync(
				userId,
				Enum.ThumbnailType.HeadShot,
				Enum.ThumbnailSize.Size180x180
			)
		end)
		if ok then
			thumbContent = content
		else
			success = false
		end
	end

	-- artificial "Detecting..." delay: random between 5 and 8 seconds
	local waitTime = math.random(5, 8)
	task.wait(waitTime)

	stopDetectingAnimation()

	if success and thumbContent then
		thumbImage.Image = thumbContent
		unlockToggles()
	else
		-- invalid username feedback
		inputStroke.Color = Color3.fromRGB(180, 70, 70)
		task.wait(0.6)
		inputStroke.Color = COLOR_BORDER
		lockToggles() -- stay locked, no valid user
	end
end)

-- if the user clears the textbox entirely, re-lock the toggles and reset thumbnail
usernameBox:GetPropertyChangedSignal("Text"):Connect(function()
	if usernameBox.Text == "" then
		lockToggles()
		thumbImage.Image = ""
	end
end)

--MAKE MAIN FRAME DRAGGABLE
local dragging, dragInput, dragStart, startPos

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

titleBar.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		main.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
	end
end)
